# ===========================
# DOCKER CONFIGURATION
# ===========================
CONTAINER_NAME=tgth-web-service
EXTERNAL_PORT=8081
PORT=8081
EXTERNAL_NETWORK=tgth-web-service-network

# ===========================
# APPLICATION CONFIGURATION
# ===========================
NODE_ENV=production

# ===========================
# RECAPTCHA CONFIGURATION
# ===========================
# Get your reCAPTCHA v3 keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ===========================
# OPTIONAL: BUNDLE ANALYZER
# ===========================
# Set to "true" to enable bundle analysis
# ANALYZE=false
